# Modèle de configuration de SinistreFlow.
# Copier ce fichier vers .env puis renseigner les valeurs : cp .env.example .env
# Le fichier .env n'est JAMAIS commité (voir .gitignore).

NODE_ENV=development
PORT=3000

# Base PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=sinistreflow
DB_NAME=sinistreflow
# Générer un mot de passe : openssl rand -base64 24
DB_PASSWORD=

# Back-office (gestionnaires)
BACKOFFICE_USER=
BACKOFFICE_PASSWORD=

# Clé API du partenaire ExpertAuto : utilisée par les tests d'intégration et par
# le connecteur partner-client/. Seul son hachage est stocké en base (table partners).
EXPERTAUTO_API_KEY=
